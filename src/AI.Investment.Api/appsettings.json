    "ServiceName": "AI.Investment.Api",
    "CorrelationIdHeader": "X-Correlation-ID",
    "AcceptInboundCorrelationId": false
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Safety": {
    "Capabilities": []
