{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Observability": {
    "ServiceName": "AI.Investment.Api.Development",
    "AcceptInboundCorrelationId": true
  },
  "Database": {
    "ConnectionString": "",
    "EnableSensitiveDataLogging": true
  },
  "Safety": {
    "KillSwitchEngaged": false,
    "Capabilities": [
      {
        "Capability": "ReferenceDataManagement",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Low",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "DataIngestion",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Low",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "OpportunityManagement",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Medium",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "ApprovalAdministration",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "High",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "SimulatedExecution",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Medium",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "AutonomyAdministration",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Critical",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      }
    ]
  },
  "Limits": {
    "CurrencyCode": "USD",
    "MaxPositionSize": 5000,
    "MaxTotalExposure": 25000,
    "MaxDailyLoss": 500,
    "MaxDrawdown": 2500,
    "MaxCostPerCycle": 50,
    "MaxActionsPerCapabilityPerDay": 25,
    "MaxConcentration": 0.25,
    "CooldownAfterLossMinutes": 60,
    "AllowedInstruments": []
  },
  "SimulatedVenue": {
    "CommissionRate": 0.001,
    "MinimumFee": 1,
    "CurrencyCode": "USD"
  },
  "Providers": {
    "SecEdgar": {
      "Enabled": false
    }
  },
  "RawArchive": {
    "RootPath": "archive"
  },
  "DataPlane": {
    "SeedSourcesOnStartup": true,
    "RunRetentionSweep": false
  },
  "Operations": {
    "WorkerName": "operations-worker",
    "MaxConcurrentCycles": 4,
    "MaxConcurrentCyclesPerCapability": 2,
    "MaxQueuedTriggers": 100,
    "MaxFiringsPerWatchPerWindow": 6,
    "FiringWindow": "01:00:00",
    "CycleMaxWallClock": "00:15:00",
    "CycleMaxModelSpend": 1.0,
    "BudgetCurrency": "USD",
    "CycleMaxProviderCalls": 50,
    "CycleMaxActions": 1,
    "OutboxLeaseDuration": "00:02:00",
    "OutboxRetryDelay": "00:00:30",
    "OutboxMaxAttempts": 8,
    "Budgets": []
  },
  "OperationsHost": {
    "RunCycles": false,
    "RunOutboxDispatcher": true,
    "StartupDelay": "00:00:30",
    "CycleInterval": "00:00:30",
    "CycleBatchSize": 4,
    "OutboxInterval": "00:00:15",
    "OutboxBatchSize": 50
  }
}
