{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Observability": {
    "ServiceName": "AI.Investment.Api.Development",
    "AcceptInboundCorrelationId": true
  },
  "Database": {
    "ConnectionString": "",
    "EnableSensitiveDataLogging": true
  },
  "Safety": {
    "KillSwitchEngaged": false,
    "Capabilities": [
      {
        "Capability": "ReferenceDataManagement",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Low",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "DataIngestion",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Low",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "OpportunityManagement",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Medium",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "ApprovalAdministration",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "High",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "SimulatedExecution",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Medium",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      },
      {
        "Capability": "AutonomyAdministration",
        "Enabled": true,
        "MaxAutoExecuteRiskTier": "Critical",
        "AllowIrreversibleAutoExecute": false,
        "AllowAiProposers": false
      }
    ]
  },
  "Limits": {
    "CurrencyCode": "USD",
    "MaxPositionSize": 5000,
    "MaxTotalExposure": 25000,
    "MaxDailyLoss": 500,
    "MaxDrawdown": 2500,
    "MaxCostPerCycle": 50,
    "MaxActionsPerCapabilityPerDay": 25,
    "MaxConcentration": 0.25,
    "CooldownAfterLossMinutes": 60,
    "AllowedInstruments": []
  },
  "SimulatedVenue": {
    "CommissionRate": 0.001,
    "MinimumFee": 1,
    "CurrencyCode": "USD"
  },
  "Providers": {
    "SecEdgar": {
      "Enabled": false
    },

    "//Eodhd": [
      "ApiKey is NOT here and must never be. It lives in the .NET user-secrets store under",
      "Providers:Eodhd:ApiKey, or in the environment variable Providers__Eodhd__ApiKey.",
      "",
      "Enabling the connector registers it; it does not activate the source, register a watch,",
      "start a cycle or make a request. Activation remains a deliberate operator act through the",
      "Action/Policy seam. See docs/Blocks/BLOCK-2-EODHD-MARKET-DATA.md section 6.",
      "",
      "SessionCloseUtc is a wall-clock UTC time, so it moves with US daylight saving: 16:00 ET is",
      "20:00Z on EDT and 21:00Z on EST. The value below is the EDT one and MUST be changed to",
      "21:00:00 when the United States leaves daylight saving, or every close will be stamped an",
      "hour early. Encoding the rule in the connector would be it inventing a trading calendar.",
      "",
      "PublicationDelay is stated rather than left to the default, and erring late is the safe",
      "direction: a publication time earlier than the truth would let a backtest act on a price",
      "before anybody could have seen it."
    ],
    "Eodhd": {
      "Enabled": true,
      "BaseAddress": "https://eodhd.com/",
      "MaxRequestsPerMinute": 60,
      "LicensingNotes": "EODHD subscription held by this installation. Storage and automated processing are permitted for internal analysis; redistribution is not. Terms are this installation's own and are recorded here because the platform cannot know them.",
      "RedistributionAllowed": false,
      "Exchanges": [
        {
          "Code": "US",
          "SessionCloseUtc": "20:00:00",
          "PublicationDelay": "04:00:00"
        }
      ]
    }
  },
  "RawArchive": {
    "RootPath": "archive"
  },
  "DataPlane": {
    "SeedSourcesOnStartup": true,
    "RunRetentionSweep": false
  },
  "Operations": {
    "WorkerName": "operations-worker",
    "MaxConcurrentCycles": 4,
    "MaxConcurrentCyclesPerCapability": 2,
    "MaxQueuedTriggers": 100,
    "MaxFiringsPerWatchPerWindow": 6,
    "FiringWindow": "01:00:00",
    "CycleMaxWallClock": "00:15:00",
    "CycleMaxModelSpend": 1.0,
    "BudgetCurrency": "USD",
    "CycleMaxProviderCalls": 50,
    "CycleMaxActions": 1,
    "OutboxLeaseDuration": "00:02:00",
    "OutboxRetryDelay": "00:00:30",
    "OutboxMaxAttempts": 8,
    "Budgets": []
  },
  "OperationsHost": {
    "RunCycles": false,
    "RunOutboxDispatcher": true,
    "StartupDelay": "00:00:30",
    "CycleInterval": "00:00:30",
    "CycleBatchSize": 4,
    "OutboxInterval": "00:00:15",
    "OutboxBatchSize": 50
  }
}
