@page "/operations"
@implements IDisposable
@inject LocalizationState L
@inject PlatformClient Client
@inject RefreshState Refresh

<PageTitle>@L["operations.title"] · @L["app.name"]</PageTitle>

<h1>@L["operations.title"]</h1>

<section class="panel">
    <div class="panel-head"><h2>@L["operations.escalations"]</h2></div>

    <DataState Loading="@_loading"
               Failure="@_escalationsFailure"
               IsEmpty="@(_escalations is { Count: 0 })"
               OnRetry="@(() => Refresh.RequestAsync())">
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">@L["operations.capability"]</th>
                        <th scope="col">@L["operations.reason"]</th>
                        <th scope="col">@L["operations.raisedAt"]</th>
                        <th scope="col">@L["opportunities.status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var escalation in _escalations ?? [])
                    {
                        <tr>
                            <td>@escalation.Capability</td>
                            <td>@escalation.Explanation</td>
                            <td>@L.Instant(escalation.RaisedAtUtc)</td>
                            <td>
                                <span class="chip @(escalation.ResolvedAtUtc is null ? "warn" : "ok")">
                                    @(escalation.ResolvedAtUtc is not null
                                        ? L["operations.resolved"]
                                        : escalation.AcknowledgedAtUtc is not null
                                            ? L["operations.acknowledged"]
                                            : L["operations.open"])
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </DataState>
</section>

<section class="panel">
    <div class="panel-head"><h2>@L["operations.cycles"]</h2></div>

    <DataState Loading="@_loading"
               Failure="@_cyclesFailure"
               IsEmpty="@(_cycles is { Count: 0 })">
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">@L["operations.capability"]</th>
                        <th scope="col">@L["opportunities.status"]</th>
                        <th scope="col">@L["operations.raisedAt"]</th>
                        <th scope="col" class="num">@L["operations.escalations"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cycle in _cycles ?? [])
                    {
                        <tr>
                            <td>@cycle.Capability</td>
                            <td>@cycle.Status · @cycle.Stage</td>
                            <td>@L.Instant(cycle.StartedAtUtc)</td>
                            <td class="num">@L.Number(cycle.EscalationCount, 0)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </DataState>
</section>

<section class="panel">
    <div class="panel-head"><h2>@L["operations.shadow"]</h2></div>

    @* Stated on the panel itself, not in a footnote: nothing here was executed. *@
    <div class="banner" role="note"><span>@L["operations.shadowNote"]</span></div>

    <DataState Loading="@_loading"
               Failure="@_shadowFailure"
               IsEmpty="@(_shadow is { Count: 0 })">
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">@L["operations.capability"]</th>
                        <th scope="col">@L["opportunities.risk"]</th>
                        <th scope="col">@L["overview.liveExecution"]</th>
                        <th scope="col">@L["operations.raisedAt"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var decision in _shadow ?? [])
                    {
                        <tr>
                            <td>@decision.Capability</td>
                            <td>@decision.RiskTier</td>
                            <td>
                                <span class="chip idle">
                                    @(decision.WouldHaveExecuted
                                        ? L["operations.shadow"]
                                        : L["state.notApplicable"])
                                </span>
                            </td>
                            <td>@L.Instant(decision.RecordedAtUtc)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </DataState>
</section>

@code {
    private IReadOnlyList<EscalationDto>? _escalations;
    private IReadOnlyList<CycleDto>? _cycles;
    private IReadOnlyList<ShadowDecisionDto>? _shadow;
    private ApiFailure? _escalationsFailure;
    private ApiFailure? _cyclesFailure;
    private ApiFailure? _shadowFailure;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        Refresh.Requested += LoadAsync;
        L.Changed += OnChanged;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        await InvokeAsync(StateHasChanged);

        var escalations = await Client.GetAsync<List<EscalationDto>>("api/operations/escalations");
        var cycles = await Client.GetAsync<List<CycleDto>>("api/operations/cycles");
        var shadow = await Client.GetAsync<List<ShadowDecisionDto>>("api/operations/shadow");

        _escalations = escalations.Value;
        _escalationsFailure = escalations.Failure;
        _cycles = cycles.Value;
        _cyclesFailure = cycles.Failure;
        _shadow = shadow.Value;
        _shadowFailure = shadow.Failure;
        _loading = false;

        await InvokeAsync(StateHasChanged);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Refresh.Requested -= LoadAsync;
        L.Changed -= OnChanged;
    }
}
