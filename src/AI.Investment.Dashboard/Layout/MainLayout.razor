@inherits LayoutComponentBase
@implements IDisposable
@inject LocalizationState Localization
@inject OperatorSession Session
@inject RefreshState Refresh
@inject IJSRuntime Js
@inject NavigationManager Navigation

@*
    The shell. It renders the sign-in screen instead of the application when nobody is signed in,
    so no page can be reached without an identity - and so a signed-out operator is never shown a
    frame full of empty panels that look like an empty platform.
*@

@if (!Session.IsSignedIn)
{
    <SignIn />
}
else
{
    <div class="shell">
        <nav class="sidebar" aria-label="@Localization["nav.menu"]">
            <div class="brand">
                <div>
                    <div class="brand-name">@Localization["app.name"]</div>
                    <div class="brand-sub">@Localization["app.subtitle"]</div>
                </div>
                <button class="quiet nav-toggle"
                        type="button"
                        aria-expanded="@(_navOpen ? "true" : "false")"
                        aria-label="@(_navOpen ? Localization["nav.close"] : Localization["nav.open"])"
                        @onclick="() => _navOpen = !_navOpen">
                    ☰
                </button>
            </div>

            <div class="nav @(_navOpen ? "open" : string.Empty)">
                <NavLink href="" Match="NavLinkMatch.All">@Localization["nav.overview"]</NavLink>
                <NavLink href="market">@Localization["nav.market"]</NavLink>
                <NavLink href="opportunities">@Localization["nav.opportunities"]</NavLink>
                <NavLink href="portfolio">@Localization["nav.portfolio"]</NavLink>
                <NavLink href="capital">@Localization["nav.capital"]</NavLink>
                <NavLink href="risk">@Localization["nav.risk"]</NavLink>
                <NavLink href="validation">@Localization["nav.validation"]</NavLink>
                <NavLink href="operations">@Localization["nav.operations"]</NavLink>
                <NavLink href="safety">@Localization["nav.safety"]</NavLink>
            </div>
        </nav>

        <div class="main">
            <header class="topbar">
                <SystemStatus />

                <span class="spacer"></span>

                <span class="meta">
                    @(Refresh.LastRefreshedUtc is null
                        ? Localization["shell.neverRefreshed"]
                        : Localization.Format("shell.lastRefreshed", Localization.Instant(Refresh.LastRefreshedUtc)))
                </span>

                <button type="button"
                        class="quiet"
                        disabled="@Refresh.InFlight"
                        @onclick="() => Refresh.RequestAsync()">
                    @(Refresh.InFlight ? Localization["shell.refreshing"] : Localization["shell.refresh"])
                </button>

                <LanguagePicker />

                <span class="meta" title="@Session.Identity?.Id">
                    @Localization["shell.signedInAs"] @Session.Identity?.DisplayName
                </span>

                <button type="button" class="quiet" @onclick="SignOutAsync">
                    @Localization["shell.signOut"]
                </button>
            </header>

            <main class="content">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private bool _navOpen;

    protected override void OnInitialized()
    {
        Localization.Changed += OnChanged;
        Session.Changed += OnChanged;
        Refresh.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Drops the credential, everything derived from it, and the browser's copy of the session.
    /// </summary>
    private async Task SignOutAsync()
    {
        Session.Clear();

        try
        {
            await Js.InvokeVoidAsync("dashboardShell.clearSession");
        }
        catch (JSException)
        {
            // A browser that refuses site data has nothing to clear. The key lived in memory and
            // is already gone, which is the part that matters.
        }

        Navigation.NavigateTo(string.Empty);
    }

    public void Dispose()
    {
        Localization.Changed -= OnChanged;
        Session.Changed -= OnChanged;
        Refresh.Changed -= OnChanged;
    }
}
