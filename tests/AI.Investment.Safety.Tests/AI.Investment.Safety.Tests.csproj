<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AI.Investment.Safety.Tests</RootNamespace>
    <AssemblyName>AI.Investment.Safety.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Infrastructure is referenced here on purpose, and it is the only test project outside the
      integration suite that references it.

      Two safety controls have no meaning as pure domain types: the kill switch, whose whole
      contract is what it answers when the database cannot be read, and the execution venue,
      whose contract is that the only registered one is simulated. Testing either against a
      re-implementation in the test project would prove the re-implementation correct.
      AI.Investment.Infrastructure already declares InternalsVisibleTo for this assembly.
    -->
    <ProjectReference Include="..\..\src\AI.Investment.Infrastructure\AI.Investment.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\AI.Investment.Application\AI.Investment.Application.csproj" />
    <ProjectReference Include="..\..\src\AI.Investment.Domain\AI.Investment.Domain.csproj" />  </ItemGroup>

</Project>
