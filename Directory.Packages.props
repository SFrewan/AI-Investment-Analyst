<Project>

  <!--
    Central Package Management.
    Projects reference packages WITHOUT a Version attribute; the version is pinned here once.

    Every entry must have a stated reason. See the "Packages added and why" section of the
    Phase 0 implementation report. Packages are added when a phase needs them, not in advance.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Phase 0 - API host and observability">
    <!-- Structured logging. Replaces the default console logger so that correlation IDs
         and per-request properties are first-class fields rather than interpolated text.

         Serilog itself is referenced explicitly, not left transitive: Program.cs calls the
         static Log API directly, and a package whose types you use directly is a direct
         dependency whose version you pin yourself. -->
    <PackageVersion Include="Serilog" Version="4.0.2" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!-- OpenAPI/Swagger UI. Already present in the pre-Phase-0 solution; retained. -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup Label="Phase 1 - persistence">
    <!-- ORM. Decision D-2: PostgreSQL + EF Core. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.10" />
    <!-- Design-time only (dotnet ef). PrivateAssets in the csproj keeps it out of the output. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10" />
    <!-- PostgreSQL provider: jsonb, ILIKE, and the time-series support later phases need. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup Label="Phase 1 - hosting primitives used by class libraries">
    <!-- The Application and Infrastructure projects are plain libraries, so the abstractions
         the ASP.NET shared framework provides to the API must be referenced explicitly. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <!-- Read by DesignTimeDbContextFactory so the EF tooling resolves the SAME connection string
         the application does, without booting the host. Without these it would need a hard-coded
         fallback, which is exactly the defect they remove.

         Json and UserSecrets are at 8.0.1, not 8.0.0 like their neighbours: transitive pinning is
         on, and Microsoft.AspNetCore.Mvc.Testing -> Microsoft.Extensions.Hosting 8.0.1 requires
         8.0.1 of both. A central 8.0.0 pins them DOWN, which NuGet reports as a downgrade
         (NU1605). Do not "tidy" these back into line with the others. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <!-- Supplies OptionsBuilder.ValidateDataAnnotations(). Part of the ASP.NET Core shared
         framework, so the API gets it free; a plain class library must reference it. -->
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Label="Phase 2 - provider connectors">
    <!-- IHttpClientFactory. Needed for a typed HttpClient: it pools and rotates handlers, which
         is what stops socket exhaustion under a long-running ingestion loop and stops a cached
         handler pinning a stale DNS entry for the life of the process. Hand-constructing
         HttpClient gets one or the other wrong.

         Referenced directly rather than relied on transitively, because AddHttpClient is called
         directly by this project's composition. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Phase 1 - test stack">
    <!-- xUnit: the .NET default, and the one the SDK templates target. -->
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!--
      Dynamic skip, which xUnit 2.x cannot do on its own.

      Without it a test whose precondition is unmet can only return early - and a test that
      returns normally is reported PASSED. Eight write-guard tests did exactly that when no
      database was reachable: they printed "SKIPPED" to the console and were counted as green.
      A verification gate that reports unproven tests as passed is worse than one that reports
      them as skipped, because the summary line is what people read.
    -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />

    <!-- Layering rules as executable assertions rather than review comments. -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- In-process host for API contract tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />

    <!-- Real PostgreSQL in a container for integration tests: real migrations, real SQL,
         real constraint violations. An in-memory provider proves none of those. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="3.10.0" />
  </ItemGroup>

  <!--
    NOT added, and each for a reason:
      FluentAssertions  - v8+ requires a commercial licence; xUnit's Assert is adequate here.
      NSubstitute       - Phase 1 uses hand-written fakes, which double as readable test
                          infrastructure and have no setup DSL to learn.
      MediatR           - handlers are called directly; a mediator would add indirection with
                          no pipeline behaviour yet to justify it.
      AutoMapper        - one hand-written mapper, checked by the compiler.
  -->

</Project>
