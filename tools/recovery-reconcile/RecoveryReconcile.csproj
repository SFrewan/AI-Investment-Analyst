<Project Sdk="Microsoft.NET.Sdk">

  <!--
    READ-ONLY final reconciliation of the five-member archived-price recovery.

    Read-only by construction, not by discipline: this tool never resolves IArchivedPayloadReplay and
    never references ArchivedPayloadReplayService, so there is no code path from here to a replay.
    Every database access is a SELECT. Both connectors are pinned off in configuration.

    Separate from tools\replay-recover on purpose. That one writes. The difference should be visible
    in the directory listing rather than in a flag.

    Composed through the production AddApplication + AddInfrastructure, exactly as the API host does,
    so the store, the archive and SplitAdjustment are all the real ones.

    Deliberately NOT in AI-Investment-Analyst.sln.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AI.Investment.Tools.RecoveryReconcile</RootNamespace>
    <AssemblyName>recovery-reconcile</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Relaxed for this tool only; the repository-wide settings are untouched. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AI.Investment.Infrastructure\AI.Investment.Infrastructure.csproj" />
  </ItemGroup>

</Project>
